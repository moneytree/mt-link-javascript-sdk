{
  "compilerOptions": {
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "removeComments": true,
		"rootDir": "./src",
    "outDir": "./dist",
    "lib": ["es2022", "dom"],
		"types": ["node", "vitest/globals"]
  },
  "include": ["./src/**/*.ts", "./src/**/*.json"],
  "exclude": ["./dist", "./node_modules"]
}
